# Copiar este archivo como .env y completar los valores reales.
# HOST y PORT son para conectarse desde tu máquina; dentro de Docker se usan db:5432.
APP_NAME="Gestion Asist"
DEBUG=true

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=gestion_asist

# Autenticación (JWT). Generar una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Orígenes del frontend permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Correo (HU-06). Gmail: smtp.gmail.com, puerto 587 y una "contraseña de aplicación"
# (no la contraseña de la cuenta). Si SMTP_HOST queda vacío, no se envían correos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remitente que ven los destinatarios. Si queda vacío se usa SMTP_USER.
SMTP_FROM=

# Push (HU-06): ruta al JSON del service account de Firebase, dentro de secrets/
# (esa carpeta no se sube a git). Si queda vacío, no se envían push.
FIREBASE_CREDENTIALS=
